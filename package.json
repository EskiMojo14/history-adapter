{
  "name": "history-adapter",
  "description": "A \"history adapter\" for managing undoable (and redoable) state changes.",
  "version": "2.1.1",
  "keywords": [
    "history",
    "redux",
    "undo",
    "redo",
    "immer",
    "patches",
    "state"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./redux": {
      "import": "./dist/redux.js",
      "require": "./dist/redux.cjs"
    }
  },
  "files": [
    "dist",
    "redux"
  ],
  "scripts": {
    "clean": "rimraf dist",
    "prepare": "vp config",
    "run-build": "vp pack",
    "build": "vpr clean && vpr type && vpr run-build",
    "build-only": "vpr clean && vpr run-build",
    "test": "vp test",
    "lint": "vp lint",
    "attw": "attw",
    "publint": "publint",
    "type": "tsc",
    "prepack": "vpr build && vpr publint",
    "size": "size-limit",
    "example": "vpr --filter example-app dev",
    "website": "vpr --filter website start"
  },
  "repository": "https://github.com/EskiMojo14/history-adapter.git",
  "author": "EskiMojo14 <ben.j.durrant@gmail.com>",
  "license": "MIT",
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.17.4",
    "@reduxjs/toolkit": "https://pkg.csb.dev/reduxjs/redux-toolkit/commit/d1059244/@reduxjs/toolkit",
    "@size-limit/preset-small-lib": "^11.2.0",
    "@types/node": "^22.14.1",
    "eslint-import-resolver-typescript": "^4.3.2",
    "globals": "^16.0.0",
    "jiti": "^2.4.2",
    "mix-n-matchers": "^1.8.1",
    "publint": "^0.3.12",
    "rimraf": "^6.0.1",
    "size-limit": "^11.2.0",
    "typescript": "^5.8.3",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": "^14.15.0 || ^16.10.0 || >=18.0.0"
  },
  "dependencies": {
    "immer": "^10.1.1"
  },
  "peerDependencies": {
    "@reduxjs/toolkit": "^1.9.7 || ^2"
  },
  "peerDependenciesMeta": {
    "@reduxjs/toolkit": {
      "optional": true
    }
  },
  "packageManager": "pnpm@10.5.2+sha256.79a98daa90248b50815e31460790f118c56fe099113370826caa0153be6daba5"
}
