{
  "name": "history-adapter",
  "version": "2.1.1",
  "description": "A \"history adapter\" for managing undoable (and redoable) state changes.",
  "keywords": [
    "history",
    "immer",
    "patches",
    "redo",
    "redux",
    "state",
    "undo"
  ],
  "license": "MIT",
  "author": "EskiMojo14 <ben.j.durrant@gmail.com>",
  "repository": "https://github.com/EskiMojo14/history-adapter.git",
  "files": [
    "dist",
    "redux"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./redux": {
      "import": "./dist/redux.js",
      "require": "./dist/redux.cjs"
    }
  },
  "scripts": {
    "clean": "rimraf dist",
    "prepare": "vp config",
    "run-build": "vp pack",
    "build": "vpr clean && vpr type && vpr run-build",
    "build-only": "vpr clean && vpr run-build",
    "test": "vp test",
    "lint": "vp lint",
    "attw": "attw",
    "publint": "publint",
    "type": "tsc",
    "prepack": "vpr build && vpr publint",
    "size": "size-limit",
    "example": "vpr --filter example-app dev",
    "website": "vpr --filter website start"
  },
  "dependencies": {
    "immer": "^10.2.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@reduxjs/toolkit": "https://pkg.csb.dev/reduxjs/redux-toolkit/commit/d1059244/@reduxjs/toolkit",
    "@size-limit/preset-small-lib": "^14.2.0",
    "@types/node": "^26.6.5",
    "jiti": "^2.7.0",
    "mix-n-matchers": "^3.0.0",
    "publint": "^0.3.25",
    "rimraf": "^6.1.3",
    "size-limit": "^14.2.0",
    "typescript": "^7.0.2",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "@reduxjs/toolkit": "^1.9.7 || ^2"
  },
  "peerDependenciesMeta": {
    "@reduxjs/toolkit": {
      "optional": true
    }
  },
  "engines": {
    "node": "^14.15.0 || ^16.10.0 || >=18.0.0"
  },
  "packageManager": "pnpm@10.5.2+sha256.79a98daa90248b50815e31460790f118c56fe099113370826caa0153be6daba5"
}
